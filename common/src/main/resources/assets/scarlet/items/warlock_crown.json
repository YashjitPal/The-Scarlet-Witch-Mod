{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": { "type": "minecraft:model", "model": "scarlet:item/warlock_crown" }
      },
      {
        "when": "head",
        "model": {
          "type": "minecraft:composite",
          "models": [
            { "type": "minecraft:model", "model": "scarlet:item/warlock_crown_worn" },
            { "type": "minecraft:model", "model": "scarlet:item/warlock_crown_worn_sides" }
          ]
        }
      }
    ],
    "fallback": { "type": "minecraft:model", "model": "scarlet:item/warlock_crown_worn" }
  }
}
